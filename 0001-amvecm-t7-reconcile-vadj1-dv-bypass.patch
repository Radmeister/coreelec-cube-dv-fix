+/*
+ * Kodi's brightness/contrast sysfs stores can re-enable VADJ1 after the DV
+ * bypass cache has already reached zero. Reconcile the live enable bit while
+ * T7 VPP0 is under STB DV bypass; keep SDR/HDR10-only and other VPPs unchanged.
+ */
+static bool pq_vadj1_sync = true;
+module_param(pq_vadj1_sync, bool, 0600);
+MODULE_PARM_DESC(pq_vadj1_sync, "Reconcile T7 STB DV VADJ1 bypass with hardware");
+static unsigned long pq_vadj1_resyncs;
+module_param(pq_vadj1_resyncs, ulong, 0444);
+MODULE_PARM_DESC(pq_vadj1_resyncs, "T7 STB DV VADJ1 enable-bit corrections");
+
+static bool t7_dv_vadj1_needs_sync(u8 requested_enable, int vpp_index)
+{
+	if (pq_vadj1_sync && is_meson_t7_cpu() && vpp_index == 0 &&
+	    dv_pq_bypass == 2 && !requested_enable &&
+	    READ_VPP_REG_BITS(VPP_VADJ1_MISC, 0, 1)) {
+		pq_vadj1_resyncs++;
+		return true;
+	}
+	return false;
+}
